# Copy to .env.local and fill in values for local development.

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Create a GA4 property at https://analytics.google.com and paste the Measurement ID.
# Required for phone/CTA/FAB click tracking. Loaded only after cookie consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-S48PMZ3L3C

# ── Robotic surgery page (/robotic-surgery) ──────────────────────────────────
# YouTube video ID only (the part after watch?v=). Optional — the page uses
# the self-hosted MP4 at /video/da-vinci-5-promotional.mp4 when this is empty.
NEXT_PUBLIC_ROBOTIC_SURGERY_YOUTUBE_ID=

# ── Contact form (Resend) — when wired up ────────────────────────────────────
# Verify ndsurgeon.com in Resend and add DNS records in Wix (SPF/DKIM).
# Send from an @ndsurgeon.com address; deliver notifications to info@ndaulatzai.com.
# RESEND_API_KEY=
# CONTACT_FORM_TO=info@ndaulatzai.com
# CONTACT_FORM_FROM=website@ndsurgeon.com
